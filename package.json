{
  "name": "creator-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:apply": "tsx --env-file=.env.local scripts/apply-schema.ts",
    "db:deploy": "tsx scripts/apply-schema.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "backfill:socials": "tsx --env-file=.env.local scripts/backfill-socials.ts",
    "verify:add-creator": "tsx --env-file=.env.local scripts/verify-add-creator.ts",
    "verify:auto-stage": "tsx --env-file=.env.local scripts/verify-auto-stage.ts",
    "verify:editors": "tsx --env-file=.env.local scripts/verify-editors.ts",
    "verify:email-ingest": "tsx --env-file=.env.local scripts/verify-email-ingest.ts",
    "verify:gmail-sync": "tsx --env-file=.env.local scripts/verify-gmail-sync.ts",
    "verify:email-body": "tsx scripts/verify-email-body.ts",
    "verify:next-step": "tsx scripts/verify-next-step.ts",
    "verify:creator-workspace": "tsx scripts/verify-creator-workspace.ts",
    "verify:gmail-health": "tsx scripts/verify-gmail-health.ts",
    "verify:gmail-sync-outcome": "tsx scripts/verify-gmail-sync-outcome.ts",
    "verify:preview-cookies": "tsx scripts/verify-preview-cookies.ts",
    "verify:design": "tsx scripts/verify-design.ts",
    "preview": "node scripts/preview/run.mjs dev",
    "preview:db": "node scripts/preview/run.mjs db",
    "preview:build": "node scripts/preview/run.mjs build",
    "preview:verify": "node scripts/preview/run.mjs verify",
    "gmail:diagnose": "tsx --env-file=.env.local scripts/gmail-diagnose.ts",
    "gmail:resync": "tsx --env-file=.env.local scripts/gmail-resync.ts",
    "verify:invariants": "tsx --env-file=.env.local scripts/verify-invariants.ts",
    "seed:clients": "tsx --env-file=.env.local scripts/seed-clients.ts",
    "fix:duplicate-shipments": "tsx --env-file=.env.local scripts/fix-duplicate-shipments.ts",
    "cron": "tsx scripts/cron-worker.ts",
    "db:backup": "tsx --env-file=.env.local scripts/backup-tables.ts",
    "stages:migrate": "tsx --env-file=.env.local scripts/stages-migrate.ts",
    "email:assess": "tsx --env-file=.env.local scripts/email-assess.ts",
    "verify:email-status": "node scripts/preview/run.mjs verify scripts/verify-email-status.ts",
    "photos:backfill": "tsx --env-file=.env.local scripts/photos-backfill.ts",
    "contracts:backfill": "tsx --env-file=.env.local scripts/contracts-backfill.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
