# Creator Manager — local env template
# Copy this to .env.local and fill in real values. .env.local is gitignored —
# never commit real secrets. See README "New teammate setup" for where each
# value comes from.

# Neon Postgres connection string.
# — If you're the project owner: your production instance.
# — If you're a new teammate: use a Neon BRANCH connection string, not
#   production. Ask the project owner for it — it's shared out of band
#   (password manager, etc.), never through git or chat.
DATABASE_URL=

# App auth (NextAuth). Generate your own, don't reuse someone else's:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002
APP_URL=http://localhost:3002

# AES-256-GCM key for secrets at rest (reserved for a future Apify-token-in-DB
# feature; nothing reads/writes it yet, so any 32-byte hex value works).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Bearer secret the Railway cron worker uses to call /api/cron/*.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Admin bootstrap for `npm run db:seed` — creates/promotes a user in the shared
# `users` table. Pick your own email/password; each teammate should have their
# own login rather than sharing one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional — only needed to use the Fetch button / metric-refresh cron.
# https://console.apify.com/account/integrations
APIFY_TOKEN=

# Optional — only needed for the (planned) AI content-type summary feature.
ANTHROPIC_API_KEY=
